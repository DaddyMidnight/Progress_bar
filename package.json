  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/virtual-object-placer.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/virtual-object-placer/issues"
  },
  "homepage": "https://virtualplacer.com",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
