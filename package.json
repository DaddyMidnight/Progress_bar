    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "@headlessui/react": "^1.7.0",
    "@heroicons/react": "^2.0.0",
    "framer-motion": "^10.16.0",
    "react-dropzone": "^14.2.0",
    "react-webcam": "^7.1.0",
    "fabric": "^5.3.0",
    "axios": "^1.6.0",
    "stripe": "^14.0.0",
    "@stripe/stripe-js": "^2.0.0",
    "next-auth": "^4.24.0",
    "@auth/prisma-adapter": "^1.0.0",
    "prisma": "^5.0.0",
